POSTGRES_USER=oltguard
POSTGRES_PASSWORD=oltguard
POSTGRES_DB=oltguard

# Chave de criptografia das credenciais de OLT (community SNMP, senha SSH).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde em local seguro - trocar depois invalida as OLTs ja cadastradas.
ENCRYPTION_KEY=

# Chave de assinatura dos tokens JWT de login. Gere com: openssl rand -hex 32
JWT_SECRET=

# Credenciais do primeiro usuario ADMIN, criado automaticamente no boot da
# api (upsert idempotente - nao sobrescreve se o usuario ja existir).
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=

# URL publica da API que o browser do usuario vai chamar (o build do
# frontend "queima" esse valor no bundle). No Coolify, use o dominio
# publico que ele atribuir ao servico api, ex: https://api.seudominio.com
VITE_API_URL=http://localhost:3000
