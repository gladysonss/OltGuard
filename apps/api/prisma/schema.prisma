generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OltBootstrapStatus {
  PENDING
  WALKING
  ACTIVE
  FAILED
}

model Olt {
  id       String @id @default(uuid())
  name     String
  ipAddress String @unique

  snmpCommunity String
  snmpPort      Int    @default(161)

  // SSH e opcional no v1 - so monitoramento via SNMP e obrigatorio.
  // Provisionamento via SSH entra depois, quando essas credenciais existirem.
  sshUsername String?
  sshPassword String?
  sshPort     Int     @default(22)

  // Estado do walk() de bootstrap — permite retomar de onde parou se falhar no meio.
  bootstrapStatus      OltBootstrapStatus @default(PENDING)
  bootstrapLastOid     String?
  bootstrapStartedAt   DateTime?
  bootstrapCompletedAt DateTime?
  bootstrapError       String?

  reconciliationEnabled         Boolean @default(true)
  reconciliationIntervalMinutes Int     @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onus             Onu[]
  provisioningJobs ProvisioningJob[]
  alarms           Alarm[]
}

/// Filtro de rede global (nao por OLT): IPs ou faixas CIDR autorizados a
/// enviar traps para a aplicacao. Se a lista estiver vazia, nenhuma
/// restricao de rede e aplicada (so a identificacao por OLT + community
/// vale). Uma vez cadastrada pelo menos uma entrada, so origens dentro de
/// alguma delas passam.
model AllowedNetwork {
  id    String @id @default(uuid())
  cidr  String @unique
  label String?

  createdAt DateTime @default(now())
}

enum OnuStatus {
  UNKNOWN
  DISCOVERED
  PROVISIONED
  ONLINE
  OFFLINE
  DOWN
  BLACKLISTED
  SIGNAL_DEGRADED
}

model Onu {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  serialNumber  String
  slotNo        Int
  portNo        Int
  logicalPortNo Int

  status     OnuStatus @default(UNKNOWN)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signalReadings SignalReading[]
  alarms         Alarm[]

  @@unique([oltId, slotNo, portNo, logicalPortNo])
  @@index([oltId, status])
}

enum SignalReadingSource {
  TRAP
  RECONCILIATION
  MANUAL
}

model SignalReading {
  id    String @id @default(uuid())
  onuId String
  onu   Onu    @relation(fields: [onuId], references: [id], onDelete: Cascade)

  rxPowerDbm Float?
  txPowerDbm Float?
  source     SignalReadingSource

  recordedAt DateTime @default(now())

  @@index([onuId, recordedAt])
}

enum ProvisioningJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model ProvisioningJob {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  onuId  String?
  action String

  status       ProvisioningJobStatus @default(PENDING)
  payload      Json?
  errorMessage String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([oltId, status])
}

enum AlarmSeverity {
  CLEAR
  INFO
  WARNING
  MINOR
  MAJOR
  CRITICAL
}

enum AlarmCondition {
  ACTIVE
  CLEARED
}

enum AlarmSource {
  OLT
  PON_LINK
  ONU
}

/// Um alarme por ocorrencia (raised -> cleared), alimentado pelo parser de traps
/// (ver apps/api/src/olt/parks-trap-mapping.ts) e pelo job de reconciliacao.
model Alarm {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  onuId String?
  onu   Onu?   @relation(fields: [onuId], references: [id], onDelete: Cascade)

  source AlarmSource
  slotNo Int
  portNo Int?
  logicalPortNo Int?

  trapOid   String
  alarmName String
  severity  AlarmSeverity
  condition AlarmCondition @default(ACTIVE)

  confirmed       Boolean   @default(false)
  confirmedAt     DateTime?
  confirmedByUserId String?
  confirmedByUser User?     @relation(fields: [confirmedByUserId], references: [id])

  raisedAt  DateTime
  clearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oltId, condition])
  @@index([oltId, slotNo, portNo])
}

enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmedAlarms Alarm[]
}
