generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OltBootstrapStatus {
  PENDING
  WALKING
  ACTIVE
  FAILED
}

/// Fabricantes de OLT suportados pelo cadastro. Hoje so PARKS tem parser de
/// traps implementado (ver parks-trap-mapping.ts) - os demais antecipam
/// outros modelos e servem para o sistema decidir, no futuro, qual parser
/// usar para cada OLT. E um enum fixo (nao editavel pelo cliente) porque
/// cada valor exige codigo de suporte proprio, ao contrario de City.
enum OltManufacturer {
  PARKS
  HUAWEI
  ZTE
  FIBERHOME
  DATACOM
}

/// Cidade onde uma ou mais OLTs estao instaladas - cadastrada pelo cliente
/// na tela de Configuracoes (ver CityController) e usada como dropdown no
/// cadastro de OLT, alem de agrupar a arvore de OLTs na tela de Alarmes.
model City {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())

  olts Olt[]
}

model Olt {
  id       String @id @default(uuid())
  name     String
  ipAddress String @unique

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  manufacturer OltManufacturer

  snmpCommunity String
  snmpPort      Int    @default(161)

  // SSH e opcional no v1 - so monitoramento via SNMP e obrigatorio.
  // Provisionamento via SSH entra depois, quando essas credenciais existirem.
  sshUsername String?
  sshPassword String?
  sshPort     Int     @default(22)

  // Estado do walk() de bootstrap — permite retomar de onde parou se falhar no meio.
  bootstrapStatus      OltBootstrapStatus @default(PENDING)
  bootstrapLastOid     String?
  bootstrapStartedAt   DateTime?
  bootstrapCompletedAt DateTime?
  bootstrapError       String?

  reconciliationEnabled         Boolean @default(true)
  reconciliationIntervalMinutes Int     @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onus             Onu[]
  provisioningJobs ProvisioningJob[]
  alarms           Alarm[]
  events           Event[]
  gponInterfaces   GponInterface[]
}

/// Interface GPON descoberta via SNMP walk em ifName (IF-MIB::ifXTable, OID
/// 1.3.6.1.2.1.31.1.1.1.1) - primeiro passo do bootstrap da OLT (ver
/// OltBootstrapService), disparado automaticamente ao cadastrar a OLT.
/// So guarda as interfaces cujo nome comeca com "gpon" (convencao Parks pra
/// porta PON, ex: "gpon0/1") - as demais (uplink, management etc) sao
/// ignoradas. Recriada do zero a cada walk (delete + insert), nao ha merge
/// incremental ainda.
model GponInterface {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  ifIndex Int
  ifName  String

  createdAt DateTime @default(now())

  @@unique([oltId, ifIndex])
}

/// Filtro de rede global (nao por OLT): IPs ou faixas CIDR autorizados a
/// enviar traps para a aplicacao. Se a lista estiver vazia, nenhuma
/// restricao de rede e aplicada (so a identificacao por OLT + community
/// vale). Uma vez cadastrada pelo menos uma entrada, so origens dentro de
/// alguma delas passam.
model AllowedNetwork {
  id    String @id @default(uuid())
  cidr  String @unique
  label String?

  createdAt DateTime @default(now())
}

/// Estado administrativo da ONU exatamente como a Parks reporta (walk SNMP
/// em oltOnuStatus, ver OltBootstrapService.walkOnus) - nao e um enum
/// generico multi-vendor porque hoje so a Parks e suportada (mesma logica de
/// Olt.manufacturer) e cada fabricante nomeia/ordena esses estados de um
/// jeito diferente.
enum OnuStatus {
  INVALID
  INACTIVE
  ACTIVATE_PENDING
  ACTIVE
  DEACTIVATE_PENDING
  DISABLE_PENDING
  DISABLE
}

model Onu {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  serialNumber  String
  /// Nome/apelido configurado na OLT pro assinante (oltOnuAlias) - opcional,
  /// muitas ONUs nao tem alias configurado.
  alias         String?
  slotNo        Int
  portNo        Int
  logicalPortNo Int

  status     OnuStatus @default(INACTIVE)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signalReadings SignalReading[]
  alarms         Alarm[]
  events         Event[]

  @@unique([oltId, slotNo, portNo, logicalPortNo])
  @@index([oltId, status])
}

enum SignalReadingSource {
  TRAP
  RECONCILIATION
  MANUAL
}

model SignalReading {
  id    String @id @default(uuid())
  onuId String
  onu   Onu    @relation(fields: [onuId], references: [id], onDelete: Cascade)

  rxPowerDbm Float?
  txPowerDbm Float?
  source     SignalReadingSource

  recordedAt DateTime @default(now())

  @@index([onuId, recordedAt])
}

enum ProvisioningJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model ProvisioningJob {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  onuId  String?
  action String

  status       ProvisioningJobStatus @default(PENDING)
  payload      Json?
  errorMessage String?

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([oltId, status])
}

enum AlarmSeverity {
  CLEAR
  INFO
  WARNING
  MINOR
  MAJOR
  CRITICAL
}

enum AlarmCondition {
  ACTIVE
  CLEARED
}

enum AlarmSource {
  OLT
  PON_LINK
  ONU
}

/// Um alarme por ocorrencia (raised -> cleared), alimentado pelo parser de traps
/// (ver apps/api/src/olt/parks-trap-mapping.ts) e pelo job de reconciliacao.
model Alarm {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  onuId String?
  onu   Onu?   @relation(fields: [onuId], references: [id], onDelete: Cascade)

  source AlarmSource
  slotNo Int
  portNo Int?
  logicalPortNo Int?

  trapOid     String
  alarmName   String
  /// Explicacao em portugues do que o alarme significa na pratica (ver
  /// ParksTrapDefinition.description em parks-trap-mapping.ts), gravada no
  /// momento do alarme para nao depender de o mapeamento nao mudar depois.
  description String?
  /// Serial da ONU quando a trap traz esse dado (ex: lOSi) - gravado direto
  /// aqui em vez de depender so do vinculo com Onu (onuId), que so resolve
  /// se ja existir um registro de Onu previamente cadastrado.
  serialNumber String?
  severity    AlarmSeverity
  condition   AlarmCondition @default(ACTIVE)

  confirmed       Boolean   @default(false)
  confirmedAt     DateTime?
  confirmedByUserId String?
  confirmedByUser User?     @relation(fields: [confirmedByUserId], references: [id])

  raisedAt  DateTime
  clearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // So um alarme ACTIVE por (oltId, trapOid, source, slotNo, portNo,
  // logicalPortNo) - impede duplicata quando duas traps de SET quase
  // simultaneas pro mesmo problema colidem na corrida find-then-create do
  // AlarmIngestService. E um indice unico PARCIAL com COALESCE nos campos
  // opcionais (Postgres nao aplica unicidade entre NULLs), que o Prisma
  // Schema DSL nao representa - existe so na migration
  // 20260917070000_alarm_active_dedup, ver alarm-ingest.service.ts.
  @@index([oltId, condition])
  @@index([oltId, slotNo, portNo])
}

/// Ocorrencia pontual sem par de limpeza (ex: ONU descoberta, mudanca de
/// status, protection switch) - vem dos grupos "Event"/"Avc" da
/// GPON-OLT-FAULT.mib (isAlarm: false em parks-trap-mapping.ts), ao
/// contrario da Alarm, que tem estado (ACTIVE/CLEARED) e vem dos grupos
/// "Alarm". Cada trap gera uma linha nova aqui, sem merge/dedup.
model Event {
  id    String @id @default(uuid())
  oltId String
  olt   Olt    @relation(fields: [oltId], references: [id], onDelete: Cascade)

  onuId String?
  onu   Onu?   @relation(fields: [onuId], references: [id], onDelete: Cascade)

  source AlarmSource
  slotNo Int
  portNo Int?
  logicalPortNo Int?

  trapOid     String
  eventName   String
  /// Ver Alarm.description - mesma ideia, gravada no momento do evento.
  description String?
  severity    AlarmSeverity

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([oltId, occurredAt])
}

enum UserRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmedAlarms Alarm[]
}
