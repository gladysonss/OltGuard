DATABASE_URL="postgresql://oltguard:oltguard@localhost:5432/oltguard?schema=public"
PORT=3000
# Porta UDP onde o receiver de traps SNMP escuta. Configure a OLT para enviar
# trap para o IP deste servidor na porta 162 (padrao) - localmente, sem
# privilegio de root, use uma porta > 1024 como 1162.
TRAP_PORT=1162
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=
JWT_SECRET=

# Usados so pelo prisma/seed.js para criar o primeiro admin (npx prisma db seed).
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=

